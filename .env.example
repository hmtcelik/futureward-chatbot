# Required: Gemini API key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional model overrides
# LLM_MODEL=gemini-3-flash-latest
# JUDGE_MODEL=gemini-3-flash-latest
# EMBEDDING_MODEL=gemini-embedding-001

# Optional retrieval tuning
# TOP_K=5
# SIMILARITY_THRESHOLD=0.55

# Optional chunking
# CHUNK_SIZE_TOKENS=500
# CHUNK_OVERLAP_TOKENS=50

# Optional crawler
# CRAWL_MAX_PAGES=50
# CRAWL_MAX_DEPTH=3
# CRAWL_REQUEST_DELAY_SECONDS=1.0

# Optional logging
# LOG_LEVEL=INFO
# LOG_FORMAT=console  # "json" | "console"
