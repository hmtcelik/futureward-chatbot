# Copy to `.env` for local development. Streamlit Cloud reads from
# `st.secrets` instead — paste the same keys into the Cloud dashboard's
# Secrets editor (see `.streamlit/secrets.toml.example` for format).

# Required
GEMINI_API_KEY=your_api_key_here

# Optional overrides (defaults in src/config.py work for the demo)
# LLM_MODEL=gemini-3-flash-preview
# JUDGE_MODEL=gemini-3-flash-preview
# EMBEDDING_MODEL=gemini-embedding-001
# TOP_K=5
# SIMILARITY_THRESHOLD=0.55
# LOG_LEVEL=INFO
# LOG_FORMAT=console
